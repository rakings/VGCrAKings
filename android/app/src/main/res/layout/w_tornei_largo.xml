<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/fondo_widget">
    <FrameLayout android:id="@+id/area" android:layout_width="wrap_content" android:layout_height="match_parent">
        <ImageView android:id="@+id/quadrato" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:adjustViewBounds="true" android:scaleType="fitStart" android:contentDescription="@string/w_tornei" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <FrameLayout android:id="@+id/tocco1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <FrameLayout android:id="@+id/tocco2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/destra" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp">
        <TextView android:id="@+id/titolo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/money" android:textColor="@color/giallo" android:textStyle="bold" android:textSize="12sp"
            android:textAllCaps="true" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:id="@+id/m1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/p1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/fondo_premio" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
                android:textColor="#2B1200" android:textStyle="bold" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/n1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginEnd="4dp" android:textColor="@color/testo" android:textSize="10.5sp"
                android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/d1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/tenue" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/m2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/p2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/fondo_premio" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
                android:textColor="#2B1200" android:textStyle="bold" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/n2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginEnd="4dp" android:textColor="@color/testo" android:textSize="10.5sp"
                android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/d2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/tenue" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/m3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/p3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/fondo_premio" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
                android:textColor="#2B1200" android:textStyle="bold" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/n3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginEnd="4dp" android:textColor="@color/testo" android:textSize="10.5sp"
                android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/d3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/tenue" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
