<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/riga" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/r_pos" android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="end"
        android:textColor="@color/tenue" android:textStyle="bold" android:textSize="12sp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginStart="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/r_nome" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="@color/testo" android:textStyle="bold" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r_uso" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/giallo" android:textStyle="bold" android:textSize="12.5sp" />
        </LinearLayout>
        <TextView android:id="@+id/r_set" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/tenue" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/r_mosse" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/tenue" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
