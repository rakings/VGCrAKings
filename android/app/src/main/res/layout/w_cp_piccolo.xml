<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/fondo_widget">
    <include android:id="@+id/testata" layout="@layout/w_testata" />
    <TextView android:id="@+id/b_nome" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/testo" android:textStyle="bold" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/b_info" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/tenue" android:textSize="10.5sp" android:maxLines="1" />
    <LinearLayout android:id="@+id/box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="5dp"
        android:background="@drawable/fondo_box" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/b_cp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/giallo" android:textStyle="bold" android:textSize="21sp" android:maxLines="1" />
        <TextView android:id="@+id/b_pos" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/testo" android:textSize="10.5sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/b_delta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:textStyle="bold" android:textSize="10.5sp" android:maxLines="1" />
</LinearLayout>
