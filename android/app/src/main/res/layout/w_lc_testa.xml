<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/riga" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="6dp" android:paddingBottom="3dp">
    <TextView android:id="@+id/h_tit" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/giallo" android:textStyle="bold" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/h_info" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/tenue" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
