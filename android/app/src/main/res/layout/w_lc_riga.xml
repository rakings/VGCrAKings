<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/riga" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp">
    <TextView android:id="@+id/r_pos" android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="end"
        android:textColor="@color/tenue" android:textStyle="bold" android:textSize="12sp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginStart="8dp">
        <TextView android:id="@+id/r_nome" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/testo" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/r_team" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/tenue" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
