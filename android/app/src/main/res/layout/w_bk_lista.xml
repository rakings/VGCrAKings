<?xml version="1.0" encoding="utf-8"?>
<!-- Bacheca: testata + 1, 2 o 3 annunci (righe aggiunte dal codice, ognuna prende la stessa altezza) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/fondo_widget">
    <include android:id="@+id/testata" layout="@layout/w_testata" />
    <TextView android:id="@+id/vuoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="@color/tenue" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="8dp" />
</LinearLayout>
