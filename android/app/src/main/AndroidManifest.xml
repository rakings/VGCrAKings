<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- per vedere se Chrome o Samsung Internet sono installati (Android 11 e successivi) -->
    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.sec.android.app.sbrowser" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <!-- Il sito a schermo intero (Trusted Web Activity): notifiche e tutto il resto come sul sito.
             src = da dove arriva l'app: apk (sito) o play (Play Store); serve all'avviso «nuova versione» del sito.
             Avvio sceglie il browser: Chrome, poi Samsung Internet, poi il predefinito (Brave chiuso dava schermo nero). -->
        <activity
            android:name=".Avvio"
            android:exported="false"
            android:label="@string/app_name">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://rakings.github.io/VGCrAKings/?app=android&amp;v=${versione}&amp;src=${fonte}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/sfondo" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/sfondo" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/sfondo" />
        </activity>
        <!-- stesso nome di prima: l'icona sulla schermata home e i link restano validi dopo l'aggiornamento -->
        <activity-alias
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:targetActivity=".Avvio"
            android:exported="true"
            android:label="@string/app_name">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://rakings.github.io/VGCrAKings/?app=android&amp;v=${versione}&amp;src=${fonte}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/sfondo" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/sfondo" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/sfondo" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rakings.github.io" android:pathPrefix="/VGCrAKings" />
            </intent-filter>
        </activity-alias>

        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />
        <activity android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize" />

        <!-- Impostazioni del widget CP bar -->
        <activity
            android:name=".CpImpostazioni"
            android:exported="true"
            android:theme="@style/TemaImpostazioni">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".WidgetTornei" android:exported="true" android:label="@string/w_tornei">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_tornei" />
        </receiver>
        <receiver android:name=".WidgetCp" android:exported="true" android:label="@string/w_cp">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_cp" />
        </receiver>
        <receiver android:name=".WidgetBacheca" android:exported="true" android:label="@string/w_bk">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.rakings.vgc.BK_AVANTI" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_bacheca" />
        </receiver>

        <receiver android:name=".WidgetLocali" android:exported="true" android:label="@string/w_lc">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_locali" />
        </receiver>

        <!-- dopo un aggiornamento dell'app ridisegna subito i widget gia' messi (nessun permesso in piu') -->
        <receiver android:name=".AppAggiornata" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".WidgetUsage" android:exported="true" android:label="@string/w_us">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_usage" />
        </receiver>

        <service android:name=".UsageListaServizio"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <service android:name=".LocaliListaServizio"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <service android:name=".CpListaServizio"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>
</manifest>
